﻿<div class="form-group @Class">
    <div class="flex-stack-horizontal form-mw">
        <label for="@_id" class="input-group-text w-100">@Name</label>
    </div>
    <div class="input-group mr-sm-2">
        @if (Icon != null)
        {
            <div class="input-group-prepend">
                <div class="input-group-text">
                    <div class="">
                        <span class="ui-icon-font ui-icon-sm @Icon"></span>
                    </div>
                </div>
            </div>
        }
        <input id="@_id" type="email" class="form-control" placeholder="@Placeholder" @bind="Url"/>
    </div>
</div>



@code {

    private string _id = $"h{Random.Shared.Next():X8}";

    [Parameter] public string Name { get; set; } = "";

    [Parameter]
    public List<Uri> Value
    {
        get;
        set
        {
            if (field.SequenceEqual(value))
                return;
            field = value;
            ValueChanged.InvokeAsync(value);
        }
    } = [];

    [Parameter] public EventCallback<List<Uri>> ValueChanged { get; set; }
    [Parameter] public string?                  Placeholder  { get; set; } = "";
    [Parameter] public string?                  Icon         { get; set; }
    [Parameter] public string                   Class        { get; set; } = "";

    private string Url
    {
        get => string.Join(";",Value.Select( x=>x.ToString()).OrderBy( x => x ));
        set
        {
            if (value == string.Join(";", Value.Select( x=>x.ToString()).OrderBy( x => x )))
                return;
            Value = value
                .Split( ";", StringSplitOptions.RemoveEmptyEntries )
                .OrderBy( x => x )
                .Select( x => new Uri(x  ) )
                .ToList()
                ;
        }
    }

}
