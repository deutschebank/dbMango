<div>
    <style>
        .md-text{
            font-size: 10pt;
        }

        code {
            color: greenyellow !important;
        }

        pre {
            color: greenyellow !important;
            background-color: #1d2a3b;
        }
    </style>
    
    <div class="md-text @Class">
        @MarkupText
    </div>
</div>

@code {

    [Parameter]
    public string Text
    {
        get;
        set
        {
            if (field == value )
                return;
            field = value;

            MarkupText = new(Markdown.ToHtml(field, _htmlPipeline));
            StateHasChanged();
        }
    } = "";

    [Parameter] public string  Class  { get; set; } = "";

    private MarkupString MarkupText { get; set; }

    private readonly MarkdownPipeline _htmlPipeline = new MarkdownPipelineBuilder()
           .UseAdvancedExtensions()
           .UseColorCode()
           .Build()
        ;


}