<div class="@Class">
    <div class="form-group" style="width: 150pt;">
        @if (ShowLabel)
        {
            <div class="flex-stack-horizontal form-mw">
                @if (SupportsCobRanges)
                {
                    <label for="@_id" class="input-group-text w-50">@(string.IsNullOrWhiteSpace(Label) ? "COB" : Label)</label>
                    <label class="toggle-switch toggle-switch-xs input-group-text w-50">
                        <input type="checkbox" @bind="UseCobRange"/>
                        <span class="slider" data-label-on="range" data-label-off="date"></span>
                    </label>
                }
                else
                {
                    <label for="cob" class="input-group-text w-100">@(string.IsNullOrWhiteSpace(Label) ? "COB date" : Label)</label>
                }
            </div>
        }
        <!--- COB selector -->
        <div class="input-group mr-sm-2">
            <DateRangePicker id="@_id" Opens="SideType.Left" SingleDatePicker="@NotUseCobRange" @bind-StartDate="CobOffset" @bind-EndDate="CobRangeEndOffset" OnRangeSelect="@SelectCob" DaysEnabledFunction="@DaysEnabledFunctionWrapper">
                <PickerTemplate Context="pickerContext">
                    <div id="@pickerContext.ParentId" @onclick="pickerContext.Toggle" class="form-control float-right datepicker-control">
                        <span class="ui-icon-font icon-calendar"></span>&nbsp;
                        <span>@pickerContext.FormattedRange @(string.IsNullOrEmpty(pickerContext.FormattedRange) ? "Latest COB" : "")</span>
                        <span class="ui-icon-font icon-caret-down float-right"></span>
                    </div>
                </PickerTemplate>
            </DateRangePicker>
        </div>
    </div>
</div>

@code {
    private string _id = $"h{Random.Shared.Next():X8}";

    private bool NotUseCobRange => !UseCobRange;

    [Parameter] public EventCallback<DateOnly?>   CobChanged          { get; set; }
    [Parameter] public EventCallback<DateOnly?>   CobRangeEndChanged  { get; set; }
    [Parameter] public EventCallback<bool  >      UseCobRangeChanged  { get; set; }
    [Parameter] public EventCallback<DateRange>   OnCobRangeChanged   { get; set; }
    [Parameter] public Func<DateOnly, bool>       DaysEnabledFunction { get; set; } = _ => true;
    [Parameter] public string?                    Label               { get; set; }

    private Func<DateTimeOffset, bool> DaysEnabledFunctionWrapper => dateTimeOffset =>
    {
        var dateOnly = DateOnly.FromDateTime(dateTimeOffset.Date);
        return DaysEnabledFunction(dateOnly);
    };

    [Parameter]
    public DateOnly? Cob
    {
        get;
        set
        {
            if (field == value)
                return;
            field = value;
            CobChanged.InvokeAsync(Cob);
        }
    }

    [Parameter]
    public DateOnly? CobRangeEnd
    {
        get;
        set
        {
            if (field == value)
                return;
            field = value;
            CobRangeEndChanged.InvokeAsync(CobRangeEnd);
        }
    }

    [Parameter]
    public bool UseCobRange
    {
        get;
        set
        {
            if (field == value)
                return;
            field = value;
            UseCobRangeChanged.InvokeAsync(UseCobRange);
            CobRangeEndChanged.InvokeAsync(CobRangeEnd);
        }
    }

    [Parameter] public bool   SupportsCobRanges { get; set; }
    [Parameter] public bool   ShowLabel         { get; set; } = true;
    [Parameter] public string Class             { get; set; } = "";

    private DateTimeOffset? CobOffset
    {
        get => Cob.HasValue ? new DateTimeOffset(Cob.Value, TimeOnly.MinValue, TimeSpan.Zero) : null;
        set
        {
            DateOnly? d = value != null ? DateOnly.FromDateTime(value.Value.Date) : null;
            Cob = d;
        }
    }

    private DateTimeOffset? CobRangeEndOffset
    {
        get
        {
            if (!UseCobRange || !CobRangeEnd.HasValue || CobRangeEnd == Cob)
                return CobOffset;
            return new DateTimeOffset(CobRangeEnd.Value, TimeOnly.MinValue, TimeSpan.Zero);
        }
        set
        {
            if (!UseCobRange)
                return;
            DateOnly? d = value != null ? DateOnly.FromDateTime(value.Value.Date) : null;
            CobRangeEnd = d;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) 
            return;

        Cob         ??= DateOnly.FromDateTime(CobHelper.GetLatestCob());
        CobRangeEnd ??= DateOnly.FromDateTime(CobHelper.GetLatestCob());
    }

    private Task SelectCob(DateRange d)
    {
        if (d == null)
        {
            Cob        = null;
            CobRangeEnd = null;
            return OnCobRangeChanged.InvokeAsync(null);
        }

        if (!UseCobRange)
            d.End = d.Start;

        Cob         = DateOnly.FromDateTime(d.Start.Date);
        CobRangeEnd = DateOnly.FromDateTime(d.End.Date);
        return OnCobRangeChanged.InvokeAsync(d);
    }
}
