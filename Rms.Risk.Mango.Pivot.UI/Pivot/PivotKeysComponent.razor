﻿<div class="@Class">
    <style>
        .z-auto {
            z-index: auto !important;
        }
    </style>
    <div class="w-100 pl-2 pr-2 mb-2">
        <input class="form-control z-auto" type="search" placeholder="Search..." @bind-value="SearchString" @bind-value:event="oninput" />
    </div>
    <DragDropList TNode="ItemWithSelection" Class="" Value="FilteredSelectedItems" Dropped="OnSelectedDropped">
        <ItemTemplate>
            <div class="flex-stack-horizontal">
                <label class="input-group-text w-25 @LabelClass" style="min-width: 200px;">@context.Text</label>
                <label class="toggle-switch toggle-switch-xs input-group-text" style="display: inline-block">
                    <input type="checkbox" @bind="context.IsSelected" @bind:after="(() => OnCheckboxChanged(context))" />
                    <span class="slider" data-label-on="on" data-label-off="off"></span>
                </label>
            </div>
        </ItemTemplate>
    </DragDropList>
    <DragDropList TNode="ItemWithSelection" Class="mt-2" Value="FilteredUnselectedItems" Dropped="OnUnselectedDropped">
        <ItemTemplate>
            <div class="flex-stack-horizontal">
                <label class="input-group-text w-25 @LabelClass" style="min-width: 200px;">@context.Text</label>
                <label class="toggle-switch toggle-switch-xs input-group-text" style="display: inline-block">
                    <input type="checkbox" @bind="context.IsSelected" @bind:after="(() => OnCheckboxChanged(context))" />
                    <span class="slider" data-label-on="on" data-label-off="off"></span>
                </label>
            </div>
        </ItemTemplate>
    </DragDropList>
</div>

@code {

    [Parameter] public IReadOnlyCollection<string> AllKeys      { get; set; } = null!;
    [Parameter] public string[]                    Value        { get; set; } = [];
    [Parameter] public EventCallback<string[]>     ValueChanged { get; set; }
    [Parameter] public string                      Class        { get; set; } = "";
    [Parameter] public string                      LabelClass   { get; set; } = "";

    internal class ItemWithSelection
    {
        public required string Text { get; init; }

        public bool IsSelected
        {
            get;
            set
            {
                if (field == value)
                    return;

                field = value;
                Changed?.Invoke(Text, value);
            }
        }

        public Action<string, bool>? Changed { get; init; }
    }

    private List<ItemWithSelection> Items { get; set; } = [];

    private List<ItemWithSelection> FilteredSelectedItems { get; set; } = [];

    private List<ItemWithSelection> FilteredUnselectedItems { get; set; } = [];

    private string SearchString
    {
        get;
        set
        {
            if (string.Equals(field, value, StringComparison.Ordinal))
                return;

            field = value;
            ApplySearch();
        }
    } = string.Empty;

    protected override void OnParametersSet()
    {
        var syncedItems = SyncToItems(Value);
        if (Same(syncedItems, Items))
            return;

        Items = syncedItems;
        ApplySearch();
    }

    private Task OnCheckboxChanged(ItemWithSelection item)
    {
        MoveItem(item, null, droppedOnList: true);
        PublishValue();
        ApplySearch();
        return InvokeAsync(StateHasChanged);
    }

    private Task OnSelectedDropped(DragDropList<ItemWithSelection>.DropEvent args)
    {
        ApplyDrop(args, true);
        return Task.CompletedTask;
    }

    private Task OnUnselectedDropped(DragDropList<ItemWithSelection>.DropEvent args)
    {
        ApplyDrop(args, false);
        return Task.CompletedTask;
    }

    private void ApplyDrop(DragDropList<ItemWithSelection>.DropEvent args, bool isSelectedTarget)
    {
        var draggedItem = args.DraggedItem;
        if (!Items.Contains(draggedItem))
            return;

        if (draggedItem.IsSelected == isSelectedTarget)
            ReorderVisibleItems(draggedItem, args.TargetItem, args.DroppedOnList, isSelectedTarget);
        else
        {
            draggedItem.IsSelected = isSelectedTarget;
            MoveItem(draggedItem, args.TargetItem, args.DroppedOnList);
        }

        draggedItem.IsSelected = isSelectedTarget;

        PublishValue();
        ApplySearch();
    }

    private void ReorderVisibleItems(ItemWithSelection draggedItem, ItemWithSelection? targetItem, bool droppedOnList, bool isSelectedTarget)
    {
        var visibleItems = (isSelectedTarget ? FilteredSelectedItems : FilteredUnselectedItems).ToList();
        if (!visibleItems.Remove(draggedItem))
            return;

        if (droppedOnList || targetItem == null)
            visibleItems.Add(draggedItem);
        else
        {
            var targetIndex = visibleItems.IndexOf(targetItem);
            if (targetIndex < 0)
                visibleItems.Add(draggedItem);
            else
                visibleItems.Insert(targetIndex, draggedItem);
        }

        Items = ReorderItems(Items, visibleItems);
    }

    private void MoveItem(ItemWithSelection item, ItemWithSelection? targetItem, bool droppedOnList)
    {
        var oldIndex = Items.IndexOf(item);
        if (oldIndex < 0)
            return;

        Items.RemoveAt(oldIndex);

        var newIndex = ResolveTargetIndex(item.IsSelected, targetItem, droppedOnList);
        if (newIndex < 0)
            newIndex = Items.Count;

        if (newIndex > Items.Count)
            newIndex = Items.Count;

        Items.Insert(newIndex, item);
    }

    private int ResolveTargetIndex(bool isSelectedTarget, ItemWithSelection? targetItem, bool droppedOnList)
    {
        if (!droppedOnList && targetItem != null)
        {
            var targetIndex = Items.IndexOf(targetItem);
            if (targetIndex >= 0)
                return targetIndex;
        }

        var lastIndex = Items.FindLastIndex(x => x.IsSelected == isSelectedTarget);
        if (lastIndex >= 0)
            return lastIndex + 1;

        return isSelectedTarget
            ? 0
            : Items.Count;
    }

    private List<ItemWithSelection> SyncToItems(string[] value)
    {
        var valueSet = new HashSet<string>(value, StringComparer.Ordinal);
        var allSet   = new HashSet<string>(AllKeys, StringComparer.Ordinal);

        var selected = value
            .Where(x => allSet.Contains(x))
            .Select(x => new ItemWithSelection { Text = x, IsSelected = true, Changed = null });

        var theRest = AllKeys
            .Where(x => !valueSet.Contains(x))
            .OrderBy(x => x)
            .Select(x => new ItemWithSelection { Text = x, IsSelected = false, Changed = null });

        return [.. selected.Concat(theRest)];
    }

    private void PublishValue()
    {
        var selected = SyncToValue(Items);
        if (Same(selected, Value))
            return;

        Value = selected;
        ValueChanged.InvokeAsync(selected);
    }

    private static bool Same(string[] v1, string[] v2)
    {
        if (v1.Length != v2.Length)
            return false;

        return !v1.Where((t, i) => t != v2[i]).Any();
    }

    private static bool Same(List<ItemWithSelection> v1, List<ItemWithSelection> v2)
    {
        if (v1.Count != v2.Count)
            return false;

        return !v1.Where((t, i) => t.Text != v2[i].Text || t.IsSelected != v2[i].IsSelected).Any();
    }

    private static string[] SyncToValue(IEnumerable<ItemWithSelection> items)
        => items.Where(x => x.IsSelected).Select(x => x.Text).ToArray();

    private void ApplySearch()
    {
        IEnumerable<ItemWithSelection> current = Items;
        if (!string.IsNullOrWhiteSpace(SearchString))
            current = current.Where(x => x.Text.Contains(SearchString, StringComparison.OrdinalIgnoreCase));

        FilteredSelectedItems   = current.Where(x => x.IsSelected).ToList();
        FilteredUnselectedItems = current.Where(x => !x.IsSelected).ToList();
    }

    private static List<ItemWithSelection> ReorderItems(
        IReadOnlyList<ItemWithSelection> items,
        IReadOnlyList<ItemWithSelection> filteredItems
    )
    {
        try
        {
            return ReorderItemsUnsafe(items, filteredItems);
        }
        catch (Exception)
        {
            if (items is List<ItemWithSelection> list)
                return list;

            return [.. items];
        }
    }

    internal static List<ItemWithSelection> ReorderItemsUnsafe(
        IReadOnlyList<ItemWithSelection> items,
        IReadOnlyList<ItemWithSelection> filteredItems
    )
    {
        if (items == null)
            throw new ArgumentNullException(nameof(items));

        if (filteredItems.Count == 0)
        {
            if (items is List<ItemWithSelection> list)
                return list;

            return [.. items];
        }

        var indexMap = new Dictionary<ItemWithSelection, int>(items.Count);
        for (var i = 0; i < items.Count; i++)
            indexMap[items[i]] = i;

        if (filteredItems.Any(f => !indexMap.ContainsKey(f)))
            throw new ArgumentException("filteredItems must be a strict subset of items.", nameof(filteredItems));

        var minIndex = filteredItems.Min(f => indexMap[f]);
        var maxIndex = filteredItems.Max(f => indexMap[f]);

        var segment = items.Skip(minIndex).Take(maxIndex - minIndex + 1).ToList();

        var filteredSet     = new HashSet<ItemWithSelection>(filteredItems);
        var othersInSegment = segment.Where(x => !filteredSet.Contains(x)).ToList();

        var resultSegment          = new List<ItemWithSelection>(segment.Count);
        var othersPos              = 0;
        var prevFilteredOrigIndex  = -1;

        foreach (var filteredItem in filteredItems)
        {
            var currentIndex = indexMap[filteredItem];

            if (prevFilteredOrigIndex != -1 && currentIndex > prevFilteredOrigIndex)
            {
                while (othersPos < othersInSegment.Count)
                {
                    var otherItem  = othersInSegment[othersPos];
                    var otherIndex = indexMap[otherItem];

                    if (otherIndex > prevFilteredOrigIndex && otherIndex < currentIndex)
                    {
                        resultSegment.Add(otherItem);
                        othersPos++;
                    }
                    else if (otherIndex <= prevFilteredOrigIndex)
                    {
                        othersPos++;
                    }
                    else
                    {
                        break;
                    }
                }
            }

            resultSegment.Add(filteredItem);
            prevFilteredOrigIndex = currentIndex;
        }

        while (othersPos < othersInSegment.Count)
            resultSegment.Add(othersInSegment[othersPos++]);

        var before = items.Take(minIndex);
        var after  = items.Skip(maxIndex + 1);
        return [.. before, .. resultSegment, .. after];
    }
}
