<FormItemSelect Name="@Name" Icon="@Icon" Class="@Class" @bind-Value="TypedValue" Values="@Values"/>

@code
{
    [Parameter]
    public IReadOnlyCollection<T> Values
    {
        get;
        set 
        {
            if (field == value)
                return;
            field = value;
            if ( !field.Contains(TypedValue))
                TypedValue = field.FirstOrDefault();
        }
    } = [];

    private T? TypedValue
    {
        get;
        set
        {
            if (field?.Equals(value) ?? false)
                return;
            field = value;
            Text = value?.ToString() ?? "";
        }
    }

    private EventCallback<T?> TypedValueChanged { get; set; }

    protected override void OnTextChanged()
    {
        TypedValue = (T)Convert.ChangeType(Text, typeof(T));
    }

}
