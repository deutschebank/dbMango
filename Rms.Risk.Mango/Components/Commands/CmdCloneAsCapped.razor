@code {

    private readonly TemplateRec _template = new()
    {
        Parameters =
        [
            new() { Type = "text", Name = "Dest collection name", Path = "$.toCollection", Icon ="icon-wrench-outline-sm" },
            new() { Type = "int",  Name = "Capped size",          Path = "$.size",         Icon ="icon-wrench-outline-sm" },
        ]
    };

    protected override string CommandTemplate => @"{
    ""cloneCollectionAsCapped"": ""[COLLECTION]"",
    ""toCollection"": """",
    ""size"": 0
}";
}
