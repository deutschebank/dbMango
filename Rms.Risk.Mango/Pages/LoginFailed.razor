<style>
    .table td {
        word-break: break-all;
    }
</style>

<h3>Login failed</h3>

@if ( !string.IsNullOrWhiteSpace( Message ) )
{
    <div class="w-100 m-2 p-4 alert-danger text-center">
        @Message
    </div>
}

<p class="mt-2">
    Login failed. dbMango uses OAuth2/OIDC for user authentication. 
    Make sure yu are using authorized email address and your password is correct.
</p>


@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "m")]
    public string Message { get; set; } = "";
}
