<TableControl Items="@_usersPivotData" Class="table table-hover table-striped fit-content" PagerSize="35">
    <TableColumnControl Name="Connected Since (UTC)" Field="ConnectedAtUtc" />
    <TableColumnControl Name="User ID" Field="Name" />
</TableControl>
