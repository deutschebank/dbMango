@page "/doc/users"
@attribute [Authorize]
@inject IConnectedUserList ConnectedUserList

@code {
    private IPivotedData _usersPivotData = new List<IConnectedUser>().ToPivotData();

    protected override void OnInitialized()
    {
        _usersPivotData = ConnectedUserList.Users.ToPivotData();
    }
}

