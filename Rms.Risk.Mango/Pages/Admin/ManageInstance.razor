<h3 class="mt-3">Manage MongoDB instance</h3>

<AuthorizedOnly Policy="AdminAccess" Resource="@UserSession.Database">
    <div class="form-row">
        <ExceptionControl Exception="@_error" />
    </div>

    <div class="flex-stack-horizontal">

        <div>
        <DatabaseInfo Database="@Database" DatabaseInstance="@DatabaseInstance" />
        </div>

        <div class="flex-stack-vertical ml-3">
            <div class="form-row">
                <div class="card card-body">
                    <h5>Create Database</h5>
                    <FormItemText Icon="icon-folder-outline-sm" Name="Database name" @bind-Value="DatabaseName" Enabled="@(!_isBusy)" />
                    <FormButton Name="Create" Icon="icon-folder-add-outline" IsPrimary="true" Enabled="@(!_isBusy)" OnClick="OnCreateDatabase" />
                </div>
            </div>

            <div class="form-row">
                <div class="card card-body">
                    <h5>Delete Database</h5>
                    <FormItemSelect Icon="icon-folder-outline-sm" Enabled="@(!_isBusy)" @bind-Value="DatabaseToDelete" Name="Database" Values="@AvailableDatabases" />
                    <FormButton Name="Drop" Icon="icon-folder-remove-outline" Enabled="@(!_isBusy)" OnClick="OnDropDatabase" />
                </div>
            </div>

        </div>

        <div class="ml-3">
            <div class="card card-body">
                <h5>Last command result</h5>
                @if (!string.IsNullOrWhiteSpace(_operationStatus))
                {
                    <div class="text-muted mb-2">@_operationStatus</div>
                }
                <FormJson Class="cmd-json" Value="@_lastOperationDetails" />
            </div>
        </div>
    </div>

</AuthorizedOnly>

@code {
    [CascadingParameter] public IModalService Modal { get; set; } = null!;

    [Parameter] public string? DatabaseStr { get; set; }
    [Parameter] public string? DatabaseInstanceStr { get; set; }

    private string Database
    {
        get => UserSession.Database;
        set
        {
            if (UserSession.Database == value)
                return;
            UserSession.Database = value;
            SyncUrl();
        }
    }

    private string DatabaseInstance
    {
        get => UserSession.DatabaseInstance;
        set
        {
            if (UserSession.DatabaseInstance == value)
                return;
            UserSession.DatabaseInstance = value;
            SyncUrl();
        }
    }


    private                 Exception?                  _error;
    private                 IReadOnlyCollection<string> AvailableDatabases   { get; set; } = [];
    private                 string                      DatabaseName         { get; set; } = "";
    private                 string                      DatabaseToDelete     { get; set; } = "";
    private                 string                      DatabaseRenameSource { get; set; } = "";
    private                 string                      DatabaseRenameTarget { get; set; } = "";
    private                 bool                        _isBusy;
    private                 object                      _lastOperationDetails  = "";
    private                 string                      _operationStatus       = "";

    private readonly HashSet<string> _systemDatabases = ["admin", "config", "local"];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (string.IsNullOrWhiteSpace(DatabaseStr))
            DatabaseStr = Database;
        else
            Database = DatabaseStr;

        if (string.IsNullOrWhiteSpace(DatabaseInstanceStr))
            DatabaseInstanceStr = DatabaseInstance;
        else
            DatabaseInstance = DatabaseInstanceStr;

        if (string.IsNullOrWhiteSpace(DatabaseToDelete))
            DatabaseToDelete = Database;
        if (string.IsNullOrWhiteSpace(DatabaseRenameSource))
            DatabaseRenameSource = Database;

        try
        {
            _error = null;

            var admin = UserSession.MongoDbAdminForAdminDatabase;

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));

            AvailableDatabases = (await admin.ListDatabases(cts.Token))
                .Select(x => x.Name )
                .Where(x => !_systemDatabases.Contains(x))
                .ToList()
                ;
        }
        catch (Exception ex)
        {
            _error = ex;
        }
        SyncUrl();
        StateHasChanged();
    }


    private void SyncUrl()
    {
        var url = NavigationManager.BaseUri + $"admin/manage/{Database}";
        if (!string.IsNullOrWhiteSpace(DatabaseInstance))
            url += $"/{DatabaseInstance}";
        JsRuntime.InvokeAsync<string>("DashboardUtils.ChangeUrl", url);
    }

    private static string? NormalizeDatabaseName(string? value)
    {
        var candidate = value?.Trim();
        return string.IsNullOrWhiteSpace(candidate) ? null : candidate;
    }

    private string? ResolveDatabaseName(string? value) => NormalizeDatabaseName(value) ?? NormalizeDatabaseName(DatabaseInstance);

    private async Task ExecuteAdminCommand(string? databaseName, Func<IMongoDbDatabaseAdminService, string, Task<object?>> handler, Func<string, string> successMessageFactory)
    {
        var ticket = await Shell.CanExecuteCommand(UserSession, InvokeAsync, Modal);
        if (string.IsNullOrWhiteSpace(ticket))
            return;

        var targetDatabase = ResolveDatabaseName(databaseName);
        if (targetDatabase == null)
        {
            _operationStatus = "Database name is required.";
            _lastOperationDetails = "";
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            _isBusy = true;
            _error = null;
            _operationStatus = $"Executing command for \"{targetDatabase}\"...";
            await InvokeAsync(StateHasChanged);

            var admin  = UserSession.GetCustomAdmin(Database, targetDatabase);
            var result = await handler(admin, targetDatabase);
            _lastOperationDetails = result ?? "";
            _operationStatus = successMessageFactory(targetDatabase);
        }
        catch (Exception ex)
        {
            _error = ex;
            _operationStatus = $"Operation failed: {ex.Message}";
            _lastOperationDetails = ex.ToString();
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnCreateDatabase()
    {
        var targetName = NormalizeDatabaseName(DatabaseName);
        if (targetName == null)
        {
            _operationStatus = "Database name is required to create a database.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        var r = await ModalDialogUtils.ShowConfirmationDialog(Modal, "Confirmation", $"Are you sure want to create database \"{targetName}\" within \"{Database}\"");
        if (!r.Confirmed)
            return;

        await ExecuteAdminCommand(targetName, async (admin, dbName) =>
        {
            const string  initCollection = "dbMango_init__";
            var           createResult   = await admin.RunCommand(new() { { "create", initCollection } });
            BsonDocument? dropResult;
            try
            {
                dropResult = await admin.RunCommand(new()  { { "drop", initCollection } });
            }
            catch (Exception dropEx)
            {
                dropResult = new()
                {
                    { "drop", initCollection },
                    { "error", dropEx.Message }
                };
            }

            var summary = new BsonDocument
            {
                { "operation", "createDatabase" },
                { "database", dbName },
                { "createCollectionResult", createResult }
            };
            summary["cleanupDropResult"] = dropResult;
            return summary;
        }, dbName => $"Database \"{dbName}\" created.");

        DatabaseInstance = targetName;
        SyncUrl();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnDropDatabase()
    {
        var r = await ModalDialogUtils.ShowConfirmationDialog(Modal, "Confirmation", $"Are you sure want to delete database \"{DatabaseToDelete}\" within \"{Database}\"");
        if (!r.Confirmed)
            return;

        await ExecuteAdminCommand(DatabaseToDelete, async (admin, dbName) =>
        {
            var result = await admin.RunCommand(new()  { { "dropDatabase", 1 } });
            result.InsertAt(0, new("operation", "dropDatabase"));
            result["database"] = dbName;
            return result;
        }, dbName => $"Database \"{dbName}\" dropped.");
    }

}
